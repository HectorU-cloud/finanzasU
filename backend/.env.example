# ============================================================
# Variables de entorno — Backend (FastAPI)
# ============================================================
# Copia este archivo a ".env" y rellena los valores reales.
# NUNCA subas el archivo ".env" al repositorio.
# ============================================================

# Base de datos PostgreSQL (Supabase, Render, Railway, etc.)
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/BASE_DE_DATOS
# Para Supabase usa el "Session Pooler" (puerto 5432).
DATABASE_URL=postgresql://postgres.xxxxxxxx:tu_password@aws-0-us-east-2.pooler.supabase.com:5432/postgres

# SSL para la base de datos. En producción (Railway) usar "require".
# En local, deja esta línea comentada o vacía.
DB_SSLMODE=require

# Clave secreta para firmar los tokens JWT.
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
# Debe tener al menos 32 caracteres.
SECRET_KEY=cambia_esta_clave_por_una_de_64_caracteres

# Orígenes permitidos para CORS (separados por coma, sin espacios).
# En local: http://localhost:5173
# En producción: https://tu-frontend.vercel.app
ALLOWED_ORIGINS=http://localhost:5173